# Copia este archivo como .env y llena tus datos. NUNCA subas el .env a GitHub.
EXCHANGE=binance
API_KEY=
API_SECRET=

SYMBOL=BTC/USDT
TIMEFRAME=1h

# paper = simulado (sin dinero real) | live = dinero real
MODE=paper

# Capital inicial para modo paper y backtest (en USDT)
CAPITAL=100
# Porcentaje del capital usado por operacion (0.0 - 1.0)
POSITION_SIZE=0.95
# Stop loss y take profit (0.02 = 2%)
STOP_LOSS=0.02
TAKE_PROFIT=0.04
# Comision del exchange por operacion (0.001 = 0.1%)
FEE=0.001

# Parametros de la estrategia
EMA_FAST=9
EMA_SLOW=21
RSI_PERIOD=14
RSI_MAX=70
