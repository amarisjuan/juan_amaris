# Copia este archivo como .env (en esta misma carpeta) y llena los valores.
# El .env NO se sube al repositorio. Nunca compartas la clave.
#
# Brevo > SMTP y API > pestaña SMTP: "Login" y una "Clave SMTP" (no la contraseña de tu cuenta).
BREVO_SMTP_USUARIO=
BREVO_SMTP_CLAVE=
# Remitente verificado en Brevo (Remitentes y dominios).
APP_CORREO_REMITENTE=no-responder@nidalinmuebles.com
# Dirección pública del portal (en producción: https://nidalinmuebles.com)
APP_URL_BASE=http://localhost:8080
# En producción con HTTPS: la cookie de sesión solo viaja cifrada.
APP_COOKIE_SEGURA=false
